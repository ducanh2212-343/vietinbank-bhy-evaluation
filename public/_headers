# Header cho Cloudflare Workers static assets (production chạy Worker `343-noi-bo`).
# Vite chép nguyên tệp này từ public/ sang dist/ khi build.
# Vercel KHÔNG đọc tệp này — cấu hình tương ứng nằm ở vercel.json.

# Tài sản build mang hash nội dung trong tên tệp: đổi nội dung là đổi tên tệp,
# nên cache vĩnh viễn được an toàn. Đây là phần giúp lần vào thứ hai của mỗi cán
# bộ gần như không tốn băng thông.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vỏ HTML phải luôn tươi, nếu không cán bộ kẹt ở bản build cũ sau khi phát hành.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# --- Bảo mật ---
# Token phiên Supabase nằm ở localStorage, nên nếu có XSS thì connect-src/img-src là
# chốt chặn cuối ngăn kẻ tấn công gửi token ra miền lạ. Chỉ mở đúng nguồn trang thực
# sự dùng: Google Fonts (CSS + file font) và Supabase (REST, Storage, Realtime qua wss).
#
# 'unsafe-inline' ở script-src hiện còn cần cho đoạn đặt sáng/tối nội tuyến trong
# index.html và handler onload của thẻ preload font; muốn bỏ thì chuyển hai chỗ đó
# sang hash SHA-256.
#
# img-src có thêm images.unsplash.com và i.ibb.co vì thư viện trụ cột (PillarGallery)
# và cây văn hoá (CultureTree) đang hiển thị ảnh từ hai nguồn này — bỏ ra là vỡ ảnh.
/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://images.unsplash.com https://i.ibb.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
